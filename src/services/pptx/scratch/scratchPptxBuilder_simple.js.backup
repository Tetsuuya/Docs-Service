import pptxgen from 'pptxgenjs';
import fs from 'fs';
import { logger } from '../../../utils/logger.js';

/**
 * NEW MULTI-TEMPLATE BUILDER - 3 Professional Templates
 * Template 1: Clean Corporate (Apple/Microsoft style)
 * Template 2: Modern Dark (Netflix/Spotify style)
 * Template 3: Vibrant Creative (Startup/Canva style)
 */

// ═══════════════════════════════════════════════════════════
// TEMPLATE DEFINITIONS
// ═══════════════════════════════════════════════════════════

const TEMPLATES = {
  clean_corporate: {
    name: 'Clean Corporate',
    bg: 'FFFFFF',
    accent: '007AFF',
    primary: '1D1D1F',
    secondary: '86868B',
    cardBg: 'F5F5F7',
    font: 'Arial'
  },
  modern_dark: {
    name: 'Modern Dark',
    bg: '141414',
    accent: 'E50914',
    primary: 'FFFFFF',
    secondary: 'B3B3B3',
    cardBg: '1F1F1F',
    font: 'Arial'
  },
  vibrant_creative: {
    name: 'Vibrant Creative',
    bg: 'F8FAFC',
    accent: 'FF6B6B',
    accent2: '4ECDC4',
    accent3: 'FFE66D',
    primary: '2D3748',
    secondary: '718096',
    cardBg: 'FFFFFF',
    font: 'Arial'
  }
};

/**
 * Select random template or use specified one
 */
function selectTemplate(templateName = null) {
  if (templateName && TEMPLATES[templateName]) {
    return { key: templateName, ...TEMPLATES[templateName] };
  }
  
  const keys = Object.keys(TEMPLATES);
  const randomKey = keys[Math.floor(Math.random() * keys.length)];
  return { key: randomKey, ...TEMPLATES[randomKey] };
}

/**
 * Build PPTX with selected template
 */
export const buildScratchPptx = async (presentationData, imagePaths = {}, templateName = null) => {
  // Check if template is specified in presentationData
  const requestedTemplate = templateName || presentationData.visualTemplate || null;
  const template = selectTemplate(requestedTemplate);
  
  logger.info(`🎨 Building with Template: "${template.name}" ${requestedTemplate ? '(forced)' : '(random)'}`);
  
  const pptx = new pptxgen();
  pptx.layout = 'LAYOUT_16x9';
  pptx.title = presentationData.title || 'Presentation';
  pptx.author = 'Docs-Service AI';

  const slides = presentationData.slides || [];
  
  // Route to appropriate template builder
  switch (template.key) {
    case 'clean_corporate':
      return buildCleanCorporate(pptx, slides, imagePaths, template);
    case 'modern_dark':
      return buildModernDark(pptx, slides, imagePaths, template);
    case 'vibrant_creative':
      return buildVibrantCreative(pptx, slides, imagePaths, template);
    default:
      return buildCleanCorporate(pptx, slides, imagePaths, template);
  }
};

// ═══════════════════════════════════════════════════════════
// TEMPLATE 1: CLEAN CORPORATE
// ═══════════════════════════════════════════════════════════

async function buildCleanCorporate(pptx, slides, imagePaths, theme) {
  const { bg, accent, primary, secondary, cardBg, font } = theme;
  
  slides.forEach((slideData, index) => {
    const slide = pptx.addSlide();
    slide.background = { color: bg };
    
    const isHero = slideData.type === 'hero' || slideData.layout === 'hero' || index === 0;
    const layout = slideData.layout || 'list';
    const slideImg = imagePaths[index];
    const hasImage = slideImg && fs.existsSync(slideImg);

    if (isHero) {
      // HERO SLIDE
      slide.addText(slideData.title || 'Presentation', {
        x: 1.5, y: 2.0, w: 7, h: 1.0,
        fontSize: 48, bold: true, color: primary, align: 'center', fontFace: font
      });
      
      if (slideData.subtitle) {
        slide.addText(slideData.subtitle, {
          x: 2.0, y: 3.2, w: 6, h: 0.5,
          fontSize: 18, color: secondary, align: 'center', fontFace: font
        });
      }
      
      // Accent line
      slide.addShape('rect', {
        x: 4.5, y: 3.85, w: 1, h: 0.05,
        fill: { color: accent }
      });
      
      slide.addText('Q1 2026', {
        x: 7.5, y: 5.0, w: 2, h: 0.3,
        fontSize: 12, color: secondary, align: 'right', fontFace: font
      });
    } else {
      // CONTENT SLIDES
      slide.addText(slideData.title || `Section ${index + 1}`, {
        x: 0.5, y: 0.6, w: 9, h: 0.5,
        fontSize: 28, bold: true, color: primary, fontFace: font
      });

      const contentTop = 1.4;

      if (layout === 'cards' && Array.isArray(slideData.cards) && slideData.cards.length > 0) {
        // THREE COLUMN CARDS
        slideData.cards.slice(0, 3).forEach((card, i) => {
          const x = 0.5 + i * 3.2;
          
          slide.addShape('roundRect', {
            x, y: contentTop, w: 2.9, h: 3.5,
            fill: { color: cardBg },
            line: { type: 'none' },
            rectRadius: 0.15
          });
          
          slide.addText(card.icon || '⭐', {
            x: x + 0.3, y: contentTop + 0.5, w: 2.3, h: 0.6,
            fontSize: 48, align: 'center'
          });
          
          slide.addText(card.title || 'Feature', {
            x: x + 0.3, y: contentTop + 1.3, w: 2.3, h: 0.4,
            fontSize: 20, bold: true, color: primary, align: 'center', fontFace: font
          });
          
          slide.addText(card.description || '', {
            x: x + 0.3, y: contentTop + 1.9, w: 2.3, h: 1.2,
            fontSize: 13, color: secondary, align: 'center', wrap: true, fontFace: font
          });
        });
      } else if (layout === 'split' && hasImage) {
        // IMAGE + BULLETS
        slide.addShape('rect', {
          x: 0.5, y: contentTop, w: 4.5, h: 3.8,
          fill: { color: cardBg }
        });
        
        slide.addText('📸', {
          x: 0.5, y: contentTop + 1.4, w: 4.5, h: 1,
          fontSize: 72, align: 'center', valign: 'middle'
        });
        
        if (hasImage) {
          slide.addImage({
            path: slideImg,
            x: 0.5, y: contentTop, w: 4.5, h: 3.8
          });
        }
        
        const bullets = Array.isArray(slideData.bullets) ? slideData.bullets : [];
        bullets.slice(0, 4).forEach((bullet, i) => {
          slide.addShape('rect', {
            x: 5.3, y: contentTop + 0.5 + i * 0.7, w: 0.08, h: 0.08,
            fill: { color: accent }
          });
          
          slide.addText(bullet, {
            x: 5.5, y: contentTop + 0.45 + i * 0.7, w: 4.0, h: 0.5,
            fontSize: 14, color: primary, fontFace: font, wrap: true
          });
        });
      } else if (layout === 'minimal' && slideData.statement) {
        // BIG STATEMENT
        slide.addText(slideData.statement, {
          x: 1, y: 2.0, w: 8, h: 1.5,
          fontSize: 72, bold: true, color: accent, align: 'center', fontFace: font, wrap: true
          });
        
        if (slideData.support) {
          slide.addText(slideData.support, {
            x: 1.5, y: 3.8, w: 7, h: 0.6,
            fontSize: 20, color: secondary, align: 'center', fontFace: font
          });
        }
      } else {
        // DEFAULT: BULLET LIST
        const bullets = Array.isArray(slideData.bullets) ? slideData.bullets : [slideData.content || 'Content'];
        const bulletItems = bullets.map(b => ({
          text: typeof b === 'string' ? b : (b.text || ''),
          options: { bullet: true, fontSize: 16, color: primary, fontFace: font }
        }));
        
        slide.addText(bulletItems, {
          x: 1.0, y: contentTop, w: 8, h: 3.5,
          valign: 'top'
        });
      }
    }
  });

  const buffer = await pptx.write({ outputType: 'nodebuffer' });
  logger.info(`✅ Clean Corporate build complete: ${slides.length} slides`);
  return buffer;
}

// ═══════════════════════════════════════════════════════════
// TEMPLATE 2: MODERN DARK
// ═══════════════════════════════════════════════════════════

async function buildModernDark(pptx, slides, imagePaths, theme) {
  const { bg, accent, primary, secondary, cardBg, font } = theme;
  
  slides.forEach((slideData, index) => {
    const slide = pptx.addSlide();
    slide.background = { color: bg };
    
    const isHero = slideData.type === 'hero' || slideData.layout === 'hero' || index === 0;
    const layout = slideData.layout || 'list';
    const slideImg = imagePaths[index];
    const hasImage = slideImg && fs.existsSync(slideImg);

    if (isHero) {
      // HERO SLIDE
      slide.addText('INNOVATION', {
        x: 0.5, y: 1.0, w: 9, h: 0.3,
        fontSize: 12, bold: true, color: accent, letterSpacing: 3, fontFace: font
      });
      
      slide.addText(slideData.title || 'Presentation', {
        x: 0.5, y: 1.5, w: 9, h: 1.2,
        fontSize: 72, bold: true, color: primary, fontFace: font
      });
      
      if (slideData.subtitle) {
        slide.addText(slideData.subtitle, {
          x: 0.5, y: 3.0, w: 6, h: 0.6,
          fontSize: 18, color: secondary, fontFace: font
        });
      }
      
      // Accent bar
      slide.addShape('rect', {
        x: 0.5, y: 4.8, w: 0.15, h: 0.5,
        fill: { color: accent }
      });
    } else {
      // CONTENT SLIDES
      slide.addText(slideData.title || `Section ${index + 1}`, {
        x: 0.5, y: 0.6, w: 9, h: 0.5,
        fontSize: 28, bold: true, color: primary, fontFace: font
      });

      const contentTop = 1.5;

      if (layout === 'stat' && (slideData.statNumber || (Array.isArray(slideData.cards) && slideData.cards.length > 0))) {
        // STATS GRID
        const stats = slideData.cards || [{ title: slideData.statNumber, description: slideData.statLabel }];
        
        stats.slice(0, 3).forEach((stat, i) => {
          const x = 0.5 + i * 3.2;
          
          slide.addShape('rect', {
            x, y: contentTop, w: 2.9, h: 2.8,
            fill: { color: cardBg }
          });
          
          // Red top border
          slide.addShape('rect', {
            x, y: contentTop, w: 2.9, h: 0.08,
            fill: { color: accent }
          });
          
          slide.addText(stat.title || stat.statNumber || '100%', {
            x: x + 0.2, y: contentTop + 1.0, w: 2.5, h: 0.8,
            fontSize: 48, bold: true, color: primary, align: 'center', fontFace: font
          });
          
          slide.addText(stat.description || stat.statLabel || 'Metric', {
            x: x + 0.2, y: contentTop + 2.0, w: 2.5, h: 0.5,
            fontSize: 16, color: secondary, align: 'center', fontFace: font
          });
        });
      } else if (layout === 'comparison' && slideData.leftSide && slideData.rightSide) {
        // TWO COLUMN
        slide.addText('THE CHALLENGE', {
          x: 0.5, y: contentTop, w: 4.2, h: 0.3,
          fontSize: 11, bold: true, color: accent, letterSpacing: 2, fontFace: font
        });
        
        slide.addText(slideData.leftSide.description || slideData.leftSide.title, {
          x: 0.5, y: contentTop + 0.5, w: 4.2, h: 2.0,
          fontSize: 16, color: secondary, wrap: true, fontFace: font
        });
        
        // Divider
        slide.addShape('rect', {
          x: 4.85, y: contentTop, w: 0.02, h: 3.0,
          fill: { color: '333333' }
        });
        
        slide.addText('OUR SOLUTION', {
          x: 5.3, y: contentTop, w: 4.2, h: 0.3,
          fontSize: 11, bold: true, color: accent, letterSpacing: 2, fontFace: font
        });
        
        slide.addText(slideData.rightSide.description || slideData.rightSide.title, {
          x: 5.3, y: contentTop + 0.5, w: 4.2, h: 2.0,
          fontSize: 16, color: primary, wrap: true, fontFace: font
        });
      } else {
        // BULLET LIST
        const bullets = Array.isArray(slideData.bullets) ? slideData.bullets : [slideData.content || 'Content'];
        
        bullets.slice(0, 5).forEach((bullet, i) => {
          slide.addText('✓', {
            x: 1.0, y: contentTop + 0.3 + i * 0.6, w: 0.4, h: 0.4,
            fontSize: 20, bold: true, color: accent, fontFace: font
          });
          
          slide.addText(bullet, {
            x: 1.6, y: contentTop + 0.3 + i * 0.6, w: 7.4, h: 0.4,
            fontSize: 18, color: primary, fontFace: font
          });
        });
      }
    }
  });

  const buffer = await pptx.write({ outputType: 'nodebuffer' });
  logger.info(`✅ Modern Dark build complete: ${slides.length} slides`);
  return buffer;
}

// ═══════════════════════════════════════════════════════════
// TEMPLATE 3: VIBRANT CREATIVE
// ═══════════════════════════════════════════════════════════

async function buildVibrantCreative(pptx, slides, imagePaths, theme) {
  const { bg, accent, accent2, accent3, primary, secondary, cardBg, font } = theme;
  
  slides.forEach((slideData, index) => {
    const slide = pptx.addSlide();
    slide.background = { color: bg };
    
    const isHero = slideData.type === 'hero' || slideData.layout === 'hero' || index === 0;
    const layout = slideData.layout || 'list';
    const slideImg = imagePaths[index];
    const hasImage = slideImg && fs.existsSync(slideImg);

    if (isHero) {
      // FUN TITLE SLIDE
      // Decorative circles
      slide.addShape('ellipse', {
        x: -0.5, y: -0.5, w: 2, h: 2,
        fill: { color: accent2, transparency: 80 }
      });
      
      slide.addShape('ellipse', {
        x: 8.5, y: 4, w: 1.8, h: 1.8,
        fill: { color: accent, transparency: 80 }
      });
      
      slide.addText(slideData.title || 'Presentation', {
        x: 1, y: 1.8, w: 8, h: 1.2,
        fontSize: 54, bold: true, color: primary, align: 'center', fontFace: font
      });
      
      // Colorful underlines
      slide.addShape('rect', {
        x: 3, y: 3.15, w: 1.5, h: 0.12,
        fill: { color: accent }
      });
      slide.addShape('rect', {
        x: 4.6, y: 3.15, w: 0.8, h: 0.12,
        fill: { color: accent2 }
      });
      slide.addShape('rect', {
        x: 5.5, y: 3.15, w: 1.5, h: 0.12,
        fill: { color: accent3 }
      });
      
      if (slideData.subtitle) {
        slide.addText(slideData.subtitle, {
          x: 2, y: 3.8, w: 6, h: 0.5,
          fontSize: 20, color: secondary, align: 'center', fontFace: font
        });
      }
    } else {
      // CONTENT SLIDES
      slide.addText(slideData.title || `Section ${index + 1}`, {
        x: 0.5, y: 0.6, w: 9, h: 0.5,
        fontSize: 32, bold: true, color: primary, fontFace: font
      });

      const contentTop = 1.5;

      if (layout === 'cards' && Array.isArray(slideData.cards) && slideData.cards.length > 0) {
        // COLORFUL ICON CARDS
        const colors = [accent, accent2, accent3];
        
        slideData.cards.slice(0, 3).forEach((card, i) => {
          const x = 0.5 + i * 3.2;
          const cardColor = colors[i % 3];
          
          slide.addShape('roundRect', {
            x, y: contentTop, w: 2.9, h: 3.0,
            fill: { color: cardBg },
            line: { color: cardColor, width: 3 },
            rectRadius: 0.2
          });
          
          slide.addText(card.icon || '⭐', {
            x: x + 0.3, y: contentTop + 0.4, w: 2.3, h: 0.6,
            fontSize: 42, align: 'center'
          });
          
          slide.addText(card.title || 'Feature', {
            x: x + 0.3, y: contentTop + 1.2, w: 2.3, h: 0.5,
            fontSize: 24, bold: true, color: cardColor, align: 'center', fontFace: font
          });
          
          slide.addText(card.description || '', {
            x: x + 0.3, y: contentTop + 1.9, w: 2.3, h: 0.8,
            fontSize: 14, color: secondary, align: 'center', fontFace: font
          });
        });
      } else if (layout === 'timeline' && Array.isArray(slideData.steps) && slideData.steps.length > 0) {
        // COLORFUL TIMELINE
        const colors = [accent, accent2, accent3];
        
        slideData.steps.slice(0, 3).forEach((step, i) => {
          const x = 0.5 + i * 3.2;
          const stepColor = colors[i % 3];
          
          // Number circle
          slide.addShape('ellipse', {
            x: x + 1.0, y: contentTop, w: 0.9, h: 0.9,
            fill: { color: stepColor }
          });
          
          slide.addText(`${i + 1}`, {
            x: x + 1.0, y: contentTop, w: 0.9, h: 0.9,
            fontSize: 32, bold: true, color: 'FFFFFF', align: 'center', valign: 'middle', fontFace: font
          });
          
          slide.addText(step.title || step, {
            x, y: contentTop + 1.2, w: 2.9, h: 0.4,
            fontSize: 20, bold: true, color: primary, align: 'center', fontFace: font
          });
          
          slide.addText(step.description || '', {
            x, y: contentTop + 1.7, w: 2.9, h: 0.8,
            fontSize: 14, color: secondary, align: 'center', wrap: true, fontFace: font
          });
          
          // Arrow
          if (i < 2) {
            slide.addText('→', {
              x: x + 3.0, y: contentTop + 0.3, w: 0.5, h: 0.5,
              fontSize: 28, color: stepColor, align: 'center'
            });
          }
        });
      } else if (layout === 'split' && hasImage) {
        // IMAGE + CONTENT WITH COLORED EDGE
        slide.addShape('rect', {
          x: 0.5, y: contentTop, w: 0.15, h: 3.5,
          fill: { color: accent }
        });
        
        slide.addShape('rect', {
          x: 0.65, y: contentTop, w: 4.0, h: 3.5,
          fill: { color: cardBg }
        });
        
        if (hasImage) {
          slide.addImage({
            path: slideImg,
            x: 0.65, y: contentTop, w: 4.0, h: 3.5
          });
        }
        
        const bullets = Array.isArray(slideData.bullets) ? slideData.bullets : [];
        bullets.slice(0, 4).forEach((bullet, i) => {
          const colors = [accent, accent2, accent3, accent];
          slide.addShape('ellipse', {
            x: 5.0, y: contentTop + 0.5 + i * 0.8, w: 0.3, h: 0.3,
            fill: { color: colors[i % 4] }
          });
          
          slide.addText(bullet, {
            x: 5.4, y: contentTop + 0.45 + i * 0.8, w: 4.1, h: 0.6,
            fontSize: 14, color: primary, fontFace: font, wrap: true
          });
        });
      } else {
        // DEFAULT: BULLET LIST WITH COLORED BULLETS
        const bullets = Array.isArray(slideData.bullets) ? slideData.bullets : [slideData.content || 'Content'];
        const colors = [accent, accent2, accent3];
        
        bullets.slice(0, 5).forEach((bullet, i) => {
          slide.addShape('ellipse', {
            x: 1.0, y: contentTop + 0.3 + i * 0.65, w: 0.25, h: 0.25,
            fill: { color: colors[i % 3] }
          });
          
          slide.addText(bullet, {
            x: 1.4, y: contentTop + 0.25 + i * 0.65, w: 7.6, h: 0.5,
            fontSize: 16, color: primary, fontFace: font, wrap: true
          });
        });
      }
    }
  });

  const buffer = await pptx.write({ outputType: 'nodebuffer' });
  logger.info(`✅ Vibrant Creative build complete: ${slides.length} slides`);
  return buffer;
}
